# ==============================================================================
# Переменные окружения для продакшен-деплоя ТТК «Интерактивная карта пространства»
# ==============================================================================

# 1. Секретный ключ для подписи JWT-токенов (сгенерируйте через: openssl rand -hex 32)
TTK_JWT_SECRET=ttk-prod-secret-change-me-7f4c2a91b8e35d6c0a4f9e2d1b7c8a63

# 2. Демо-учётная запись администратора / организатора
TTK_ADMIN_EMAIL=admin@ttk.example.com
TTK_ADMIN_PASSWORD=Admin12345!
TTK_ADMIN_INVITE_CODE=TTK-ADMIN-2026

# 3. Демо-учётная запись посетителя
TTK_USER_EMAIL=user@ttk.example.com
TTK_USER_PASSWORD=User12345!

# 4. Базовый публичный URL площадки (адрес вашего VPS / сервера или домен)
# Пример: https://map.ttk.ru или http://192.168.1.50 или http://localhost
PUBLIC_MAP_BASE_URL=http://localhost

# 5. Разрешённые CORS-источники (через запятую или * для открытого API)
TTK_CORS_ORIGINS=*

# 6. Внешние порты хоста (при необходимости можно изменить)
PORT_HTTP=80
PORT_BACKEND=8000
PORT_CLIENT=3000
PORT_ADMIN=3001
